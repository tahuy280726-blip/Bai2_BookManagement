@model List<Bai2_BookManagement.Models.Book>
@{
    ViewData["Title"] = "Book Management";
}

<h1>Book Management</h1>
<a class="btn" asp-action="Create">+ Thêm sách</a>

@if (TempData["Success"] != null)
{
    <p class="success">@TempData["Success"]</p>
}

<table>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Price</th>
        <th>Thao tác</th>
    </tr>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Id</td>
            <td>@book.Name</td>
            <td>@book.Price</td>
            <td><a class="btn" asp-action="Detail" asp-route-id="@book.Id">Chi tiết</a></td>
        </tr>
    }
</table>
